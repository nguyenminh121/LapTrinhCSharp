@model LuyenTap.Models.SearchProductsViewModel

@{
	ViewData["Title"] = "Search Products";
}

<div class="row justify-content-center">
	<div class="col-lg-9">
		<h1 class="mb-3">Search Products in store DB</h1>
		<p class="text-muted">Nhap tu khoa, he thong se tim theo ModelNumber hoac ModelName (contains).</p>

		<form method="get" asp-controller="Home" asp-action="Search" class="card p-3 shadow-sm mb-4">
			<div class="row g-2 align-items-end">
				<div class="col-md-9">
					<label for="keyword" class="form-label">Keyword</label>
					<input id="keyword" name="keyword" class="form-control" value="@Model.Keyword" placeholder="Example: pro, 1001, samsung" />
				</div>
				<div class="col-md-3 d-grid">
					<button type="submit" class="btn btn-primary">Search</button>
				</div>
			</div>
		</form>

		@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
		{
			<div class="alert alert-danger">@Model.ErrorMessage</div>
		}
		else if (!string.IsNullOrWhiteSpace(Model.Keyword))
		{
			<div class="mb-2">
				<strong>Keyword:</strong> @Model.Keyword<br />
				<strong>Matched records:</strong> @Model.Results.Count
			</div>

			if (!Model.Results.Any())
			{
				<div class="alert alert-warning">Khong tim thay ban ghi phu hop.</div>
			}
			else
			{
				<div class="table-responsive">
					<table class="table table-bordered table-striped">
						<thead>
							<tr>
								<th style="width:220px;">ModelNumber</th>
								<th>ModelName</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.Results)
							{
								<tr>
									<td>@item.ModelNumber</td>
									<td>@item.ModelName</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	</div>
</div>

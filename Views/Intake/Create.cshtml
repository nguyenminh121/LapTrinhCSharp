@model Intake
@{
    ViewData["Title"] = "Thêm Khóa tuy?n sinh m?i";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" placeholder="VD: K20, K21..." />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" type="number" placeholder="VD: 2024" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">L?u</button>
            <a asp-action="Index" class="btn btn-secondary">H?y</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

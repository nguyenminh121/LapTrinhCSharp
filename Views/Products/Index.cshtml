@model IEnumerable<LuyenTap.Models.Product>

@{
    ViewData["Title"] = "San pham";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sach san pham</h2>
    <a class="btn btn-outline-primary" asp-controller="Cart" asp-action="Index">Xem gio hang</a>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@(item.ModelName ?? "No Name")</h5>
                    <p class="card-text mb-1"><strong>Model:</strong> @(item.ModelNumber ?? "N/A")</p>
                    <p class="card-text text-muted">@item.Description</p>
                    <p class="fw-bold text-danger mt-auto">@item.UnitCost.ToString("N0") VND</p>
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@item.Id" />
                        <input type="number" name="quantity" value="1" min="1" class="form-control" style="max-width:90px;" />
                        <button type="submit" class="btn btn-success">Them vao gio</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@model LuyenTap.Models.Product

@{
    ViewData["Title"] = "Sua san pham";
}

<h2>Sua san pham</h2>

<form asp-controller="AdminProducts" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_ProductForm" model="Model" />
    <button type="submit" class="btn btn-primary">Cap nhat</button>
    <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-secondary">Huy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model Curriculum
@{
    ViewData["Title"] = "Thêm Ch??ng trình ?ào t?o m?i";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="MajorId" class="form-label"></label>
                <select asp-for="MajorId" asp-items="@((List<SelectListItem>)ViewBag.Majors)" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="IntakeId" class="form-label"></label>
                <select asp-for="IntakeId" asp-items="@((List<SelectListItem>)ViewBag.Intakes)" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="TotalCredits" class="form-label"></label>
                <input asp-for="TotalCredits" class="form-control" type="number" />
                <span asp-validation-for="TotalCredits" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">L?u</button>
            <a asp-action="Index" class="btn btn-secondary">H?y</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
